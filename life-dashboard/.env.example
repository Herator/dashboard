# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Required for the AI editing layer (meal plan, workouts, reminders).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the AI model used for editing (default: claude-opus-5).
# Leave commented out to use the default — an explicitly blank value is still
# "set" and would be used verbatim.
# AI_MODEL_ID=

# Optional: the frontend's origin, for CORS (default: http://localhost:5173).
# Leave commented out to use the default.
# FRONTEND_ORIGIN=

# The browser-facing URL the frontend is served at once deployed (e.g.
# https://home.example.com) — baked into the built frontend so it knows
# where to call the API. Leave commented out for local/dev use, where it
# defaults to http://localhost:8080.
# PUBLIC_URL=
